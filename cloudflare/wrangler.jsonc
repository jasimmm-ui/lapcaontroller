{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquid-glass-remote-relay",
  "main": "worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayHub"] }],
  "vars": {
    "FRONTEND_ORIGINS": "https://lapcontroller.vercel.app"
  }
}
