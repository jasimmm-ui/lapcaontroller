{
  "name": "liquid-glass-remote",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:relay": "node --watch relay/index.js",
    "dev:receiver": "node receiver/launch.js",
    "dev:all": "concurrently -k \"npm:dev:relay\" \"npm:dev\"",
    "build": "vite build",
    "start": "node receiver/index.js",
    "start:legacy": "node server/index.js",
    "relay:start": "node relay/index.js",
    "build:windows-stage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -StageOnly",
    "build:windows-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "vite": "^6.3.5",
    "wrangler": "^4.154.0"
  }
}
