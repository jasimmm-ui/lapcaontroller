# Local Windows receiver development. Use the loopback URL for local relay testing.
RELAY_URL=http://127.0.0.1:8788
MOCK_MODE=true

# Relay service. Use a stable 32+ byte random secret; do not publish it.
PORT=8788
RELAY_HOST=127.0.0.1
RELAY_DB_PATH=./relay/data/relay.sqlite
RELAY_PEPPER=replace-with-a-random-secret-of-at-least-32-bytes
FRONTEND_ORIGINS=https://lapcontroller.vercel.app,http://localhost:5173
# Set to the number of trusted HTTPS reverse proxies in front of the relay.
TRUST_PROXY_HOPS=0

# Set this in Vercel's project environment for production frontend builds.
# VITE_RELAY_URL=https://your-relay-domain
