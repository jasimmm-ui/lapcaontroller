# Bind to a specific private IPv4 address only after completing README TLS setup.
REMOTE_HOST=127.0.0.1
REMOTE_PORT=8787
MOCK_MODE=true
# Required when REMOTE_HOST is a LAN address; never use plain HTTP on a LAN.
TLS_PFX=./certs/laptop-cert.pfx
TLS_PFX_PASS=
# Or use PEM files instead of a PFX:
# TLS_CERT=./certs/laptop-cert.pem
# TLS_KEY=./certs/laptop-key.pem
# Required in LAN mode; replace with your Wi-Fi network's subnet.
ALLOWED_CIDR=192.168.1.0/24
# Optional; exact HTTPS origin(s) for a separately hosted UI, comma-separated.
ALLOWED_ORIGINS=https://your-project.vercel.app
